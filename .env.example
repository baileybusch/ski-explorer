# SkiScope eve agent — set in Vercel project settings. Never commit secrets.

# Model (Vercel AI Gateway). OIDC on Vercel is enough in preview/prod;
# locally set a Gateway key. Cheap/fast default is openai/gpt-5.4-mini.
AI_GATEWAY_API_KEY=
EVE_MODEL=
ASK_MODEL=
AI_GATEWAY_MODEL=
ASK_LLM=

# Langfuse via OpenTelemetry (no-op when unset)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Email reports (kill switch is public/config.js EMAIL_ALERTS_ENABLED=false)
RESEND_API_KEY=
RESEND_FROM=
AUTH_TOKEN_SECRET=
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
DIGEST_ALLOWLIST=baileybusch@gmail.com
SITE_URL=https://skiscope.vercel.app

# Existing admin / weather
ADMIN_PASSWORD=
SKISCOPE_CONTACT=baileybusch@gmail.com
WEATHER_PROVIDER=openmeteo
