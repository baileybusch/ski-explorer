{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=600, stale-while-revalidate=86400" }] },
    { "source": "/maplibre-gl-worker.mjs", "headers": [
      { "key": "Content-Type", "value": "text/javascript; charset=utf-8" },
      { "key": "Cache-Control", "value": "public, max-age=86400" }
    ] }
  ],
  "crons": [
    { "path": "/api/cron/alerts", "schedule": "0 3 * * *" }
  ],
  "rewrites": [
    { "source": "/manage", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/disclosure", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" }
  ]
}
