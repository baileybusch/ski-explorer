{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    { "source": "/data/observed.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=120, stale-while-revalidate=1800" }] },
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=600, stale-while-revalidate=86400" }] },
    { "source": "/maplibre-gl-worker.mjs", "headers": [
      { "key": "Content-Type", "value": "text/javascript; charset=utf-8" },
      { "key": "Cache-Control", "value": "public, max-age=86400" }
    ] }
  ],
  "functions": {
    "api/headless.js": { "includeFiles": "public/data/**", "maxDuration": 60 },
    "api/agent.js": { "includeFiles": "public/data/**" },
    "api/cron/alerts.js": { "includeFiles": "public/data/**" },
    "api/email/preview.js": { "includeFiles": "public/data/**" },
    "api/admin/render.js": { "includeFiles": "public/data/**" },
    "api/confirm.js": { "includeFiles": "public/data/**" },
    "api/auth.js": { "includeFiles": "public/data/**" }
  },
  "crons": [
    { "path": "/api/cron/alerts", "schedule": "0 3 * * *" }
  ],
  "rewrites": [
    { "source": "/api/mcp", "destination": "/api/headless?surface=mcp" },
    { "source": "/api/mcp/", "destination": "/api/headless?surface=mcp" },
    { "source": "/api/search", "destination": "/api/headless?surface=search" },
    { "source": "/api/search/", "destination": "/api/headless?surface=search" },
    { "source": "/api/data", "destination": "/api/headless?surface=data" },
    { "source": "/api/data/", "destination": "/api/headless?surface=data" },
    { "source": "/api/observed", "destination": "/api/headless?surface=observed" },
    { "source": "/api/observed/", "destination": "/api/headless?surface=observed" },
    { "source": "/api/ask", "destination": "/api/headless?surface=ask" },
    { "source": "/api/ask/", "destination": "/api/headless?surface=ask" },
    { "source": "/api/events", "destination": "/api/headless?surface=events" },
    { "source": "/api/admin", "destination": "/api/admin/render?surface=dashboard" },
    { "source": "/api/admin/", "destination": "/api/admin/render?surface=dashboard" },
    { "source": "/manage", "destination": "/" },
    { "source": "/manage/", "destination": "/" },
    { "source": "/about", "destination": "/" },
    { "source": "/about/", "destination": "/" },
    { "source": "/privacy", "destination": "/" },
    { "source": "/privacy/", "destination": "/" },
    { "source": "/terms", "destination": "/" },
    { "source": "/terms/", "destination": "/" },
    { "source": "/disclosure", "destination": "/" },
    { "source": "/disclosure/", "destination": "/" },
    { "source": "/contact", "destination": "/" },
    { "source": "/contact/", "destination": "/" },
    { "source": "/my-alerts", "destination": "/" },
    { "source": "/my-alerts/", "destination": "/" },
    { "source": "/do-not-sell", "destination": "/" },
    { "source": "/do-not-sell/", "destination": "/" },
    { "source": "/admin", "destination": "/" },
    { "source": "/admin/", "destination": "/" },
    { "source": "/region/:id", "destination": "/" },
    { "source": "/pass/:id", "destination": "/" },
    { "source": "/resort/:id", "destination": "/" }
  ]
}
